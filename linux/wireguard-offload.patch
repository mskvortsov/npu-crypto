diff --git a/drivers/net/wireguard/npu_crypto.c b/drivers/net/wireguard/npu_crypto.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireguard/npu_crypto.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <crypto/aead.h>
+#include <crypto/chacha20poly1305.h>
+#include <linux/slab.h>
+#include <linux/module.h>
+#include <linux/rcupdate.h>
+#include <linux/unaligned.h>
+#include "npu_crypto.h"
+#include "peer.h"
+
+bool wg_npu_only;
+module_param_named(npu_only, wg_npu_only, bool, 0644);
+MODULE_PARM_DESC(npu_only, "Test mode: queue all data crypto on NPU; never use software (default: false)");
+
+struct wg_npu_request {
+	struct aead_request *req;
+	struct noise_keypair *keypair;
+	struct wg_peer *peer;
+	void (*done)(void *, bool);
+	void *data;
+	size_t len;
+	u64 counter;
+	bool decrypt, npu_only;
+	u8 iv[12];
+	struct scatterlist sg[];
+};
+
+struct crypto_aead *wg_npu_alloc(const u8 key[32])
+{
+	struct crypto_aead *tfm;
+	int ret;
+	tfm = crypto_alloc_aead("airoha-npu-chacha20poly1305", 0, 0);
+	if (IS_ERR(tfm))
+		return NULL;
+	ret = crypto_aead_setkey(tfm, key, 32);
+	if (!ret)
+		ret = crypto_aead_setauthsize(tfm, 16);
+	if (ret) {
+		crypto_free_aead(tfm);
+		return NULL;
+	}
+	return tfm;
+}
+
+/* The drain waits for zero and an RCU grace period. Keep the final peer
+ * reference release inside that period so device destruction cannot race it.
+ */
+static void wg_npu_put(struct wg_peer *peer)
+{
+	rcu_read_lock();
+	if (atomic_dec_and_test(&peer->npu_inflight))
+		wake_up_all(&peer->npu_wait);
+	wg_peer_put(peer);
+	rcu_read_unlock();
+}
+
+static void wg_npu_complete(void *data, int err)
+{
+	struct wg_npu_request *ctx = data;
+	struct wg_peer *peer = ctx->peer;
+	bool ok = !err;
+
+	if (err == -EINPROGRESS)
+		return;
+	/* Transport failures leave the packet untouched. Authentication failures
+	 * must never be retried as successful software decryptions.
+	 */
+	if (err && err != -EBADMSG && !ctx->npu_only) {
+		if (ctx->decrypt)
+			ok = chacha20poly1305_decrypt_sg_inplace(
+				ctx->sg, ctx->len, NULL, 0, ctx->counter,
+				ctx->keypair->receiving.key);
+		else
+			ok = chacha20poly1305_encrypt_sg_inplace(
+				ctx->sg, ctx->len, NULL, 0, ctx->counter,
+				ctx->keypair->sending.key);
+	}
+	aead_request_free(ctx->req);
+	ctx->done(ctx->data, ok);
+	kfree_sensitive(ctx);
+	/* done may publish the packet and release its peer/keypair references.
+	 * Keep our peer reference until teardown can observe completion.
+	 */
+	wg_npu_put(peer);
+}
+
+int wg_npu_submit(struct scatterlist *sg, unsigned int nents, size_t len,
+		  struct noise_keypair *keypair, u64 counter, bool decrypt,
+		  void (*done)(void *, bool), void *data)
+{
+	struct crypto_aead *tfm = decrypt ? keypair->npu_receiving :
+					    keypair->npu_sending;
+	struct wg_npu_request *ctx;
+	struct wg_peer *peer;
+	bool strict = READ_ONCE(wg_npu_only);
+	int ret;
+
+	if (!tfm || (!strict && len <= 1024 + (decrypt ? 16 : 0)))
+		return -EAGAIN;
+	ctx = kzalloc(struct_size(ctx, sg, nents), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->req = aead_request_alloc(tfm, GFP_KERNEL);
+	if (!ctx->req) {
+		kfree(ctx);
+		return -ENOMEM;
+	}
+	memcpy(ctx->sg, sg, sizeof(*sg) * nents);
+	ctx->keypair = keypair;
+	ctx->peer = peer = wg_peer_get(keypair->entry.peer);
+	ctx->done = done;
+	ctx->data = data;
+	ctx->len = len;
+	ctx->counter = counter;
+	ctx->decrypt = decrypt;
+	ctx->npu_only = strict;
+	put_unaligned_le64(counter, ctx->iv + 4);
+	/* Test mode requests bounded driver backlog, including small packets. */
+	aead_request_set_callback(ctx->req, CRYPTO_TFM_REQ_MAY_SLEEP |
+				  (strict ? CRYPTO_TFM_REQ_MAY_BACKLOG : 0),
+				  wg_npu_complete, ctx);
+	aead_request_set_ad(ctx->req, 0);
+	aead_request_set_crypt(ctx->req, ctx->sg, ctx->sg, len, ctx->iv);
+	atomic_inc(&peer->npu_inflight);
+	ret = decrypt ? crypto_aead_decrypt(ctx->req) :
+			crypto_aead_encrypt(ctx->req);
+	if (ret == -EINPROGRESS)
+		return ret; /* ctx may already have been freed by the callback. */
+	aead_request_free(ctx->req);
+	kfree_sensitive(ctx);
+	wg_npu_put(peer);
+	return ret;
+}
diff --git a/drivers/net/wireguard/npu_crypto.h b/drivers/net/wireguard/npu_crypto.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireguard/npu_crypto.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WG_NPU_CRYPTO_H
+#define WG_NPU_CRYPTO_H
+#include <linux/scatterlist.h>
+#include <linux/types.h>
+extern bool wg_npu_only;
+struct noise_keypair;
+struct crypto_aead;
+struct crypto_aead *wg_npu_alloc(const u8 key[32]);
+/* -EINPROGRESS transfers ownership to done, which may run before return.
+ * Other returns leave ownership with the caller; no callback is made.
+ */
+int wg_npu_submit(struct scatterlist *sg, unsigned int nents, size_t len,
+		  struct noise_keypair *keypair, u64 counter, bool decrypt,
+		  void (*done)(void *, bool), void *data);
+#endif
