{
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": ["--background-index", "--query-driver=**/*"]
      }
    }
  },
  "languages": {
    "C": {
      "show_wrap_guides": true,
      "wrap_guides": [80],
      "hard_tabs": true,
      "tab_size": 8
    }
  },
  "file_types": {
    "C": ["*.h"]
  }
}
